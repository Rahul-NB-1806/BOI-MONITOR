<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Backup Rules (Android 12+)
  Excludes sensitive local caches from auto-backup.
  Firebase data lives in Firestore cloud — no local backup needed.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
