<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Warning Banner -->
            <TextView
                android:id="@+id/banner_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="@color/warning_red"
                android:background="@color/banner_red_bg"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textStyle="bold" />

            <!-- UPI Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPI TRANSACTIONS"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_upi_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Count: --  |  -- MB"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_upi"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_upi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete All UPI"
                        android:textSize="12sp"
                        app:backgroundTint="@color/status_returned" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Cheque Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHEQUE TRANSACTIONS"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_cheque_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Count: --  |  -- MB"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_cheque"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_cheque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete All Cheques"
                        android:textSize="12sp"
                        app:backgroundTint="@color/status_returned" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Logs Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOTIFICATION LOGS"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_log_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Count: --  |  -- MB"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_log"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@drawable/progress_bar_green" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete All Logs"
                        android:textSize="12sp"
                        app:backgroundTint="@color/status_returned" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Total Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL STORAGE"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_total_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- MB"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_total"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_green" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Date-wise Delete Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE-WISE DELETE"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete records older than"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/et_days"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:hint="30"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:background="@drawable/edit_text_bg"
                            android:padding="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  days"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pick Date"
                            android:textSize="12sp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_selected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delete Selected"
                        app:backgroundTint="@color/status_returned" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
